fn cfun();
fn arg_cfun(arg: MyStruct, b: i32, c: f32, s: Small) -> Small;

struct MyStruct {
    a: i32,
    c: i16,
    d: f32,
    e: f32,
    l: i64
}

struct Small {
    a: i32,
    b: f32,
    c: f32
}

public fn main() -> i32 {
    let var: Small = arg_cfun(MyStruct {a: 3, c: 1, d: 4, e: 3.14, l: 124}, 15, 32.7, Small {a: 1, b: 1.2, c: 1.3});

    arg_cfun(MyStruct {a: 3, c: 1, d: 4, e: 3.14, l: 124}, 0, 0.0, var);

    return 0;
}

fn abi_second() -> MyStruct {
    return MyStruct {a: 3, c: 1, d: 4, e: 3.14, l: 124};
}
