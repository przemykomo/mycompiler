fn extern_fn(arg: MyStruct, num: i32) -> bool;
fn other_fn();

struct MyStruct {
    a: bool,
    b: f32,
    c: i32
}

public fn main() -> i32 {
    let my_struct: MyStruct = MyStruct {
        a: true,
        b: 3.14,
        c: 8
    };

    let ret: bool = extern_fn(my_struct, 5);
    if ret {
        other_fn(),
    }

    return 0;
}

